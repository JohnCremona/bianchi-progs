test_nsp_1: make_nsp_loop display_nsp_loop
	@d=4; mkdir -p $(NSP_DIR)/2.0.$${d}.1
	@d=1; prog=make_nsp_loop; $(check_run)
	@d=1; prog=display_nsp_loop; $(check_run)
	@d=4; rm -rf $(NSP_DIR)/2.0.$${d}.1

